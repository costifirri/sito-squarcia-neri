---
import '@fontsource/exo-2/400.css';
import '@fontsource/exo-2/500.css';
import '@fontsource/exo-2/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { studio, mancante } from '../lib/studio';
import { datiStrutturati } from '../lib/schema';
import { ui, type Lingua } from '../i18n/ui';

interface Props {
  lingua: Lingua;
  titolo: string;
  descrizione: string;
  /** Indirizzo della stessa pagina nell'altra lingua, es. "/en/about/" */
  altraLingua: string;
  noindex?: boolean;
}

const { lingua, titolo, descrizione, altraLingua, noindex = false } = Astro.props;
const t = ui[lingua];
const altra: Lingua = lingua === 'it' ? 'en' : 'it';
const titoloCompleto = titolo.includes(studio.nomeSenzaTitolo) ? titolo : `${titolo} | ${studio.nome}`;
const haDominio = !mancante(studio.dominio);
const assoluto = (percorso: string) => new URL(percorso, Astro.site).href;
const canonico = assoluto(Astro.url.pathname);
const predefinito = assoluto(lingua === 'it' ? Astro.url.pathname : altraLingua);
// Finché "pubblicato" è false in studio.json, i motori di ricerca non indicizzano il sito.
const nonIndicizzare = noindex || !studio.pubblicato;
const altImmagine = `${studio.nome}, ${lingua === 'it' ? 'chirurgo plastico' : 'plastic surgeon'}`;
---

<!doctype html>
<html lang={lingua}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloCompleto}</title>
    <meta name="description" content={descrizione} />
    {nonIndicizzare && <meta name="robots" content="noindex, nofollow" />}
    {haDominio && <link rel="canonical" href={canonico} />}
    {haDominio && <link rel="alternate" hreflang={lingua} href={canonico} />}
    {haDominio && <link rel="alternate" hreflang={altra} href={assoluto(altraLingua)} />}
    {haDominio && <link rel="alternate" hreflang="x-default" href={predefinito} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#020821" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={studio.nome} />
    <meta property="og:title" content={titoloCompleto} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:locale" content={lingua === 'it' ? 'it_IT' : 'en_GB'} />
    {haDominio && <meta property="og:url" content={canonico} />}
    <meta property="og:image" content={haDominio ? assoluto('/og.png') : '/og.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={altImmagine} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(datiStrutturati(lingua, Astro.site))} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="salta" href="#contenuto">{t.saltaAlContenuto}</a>
    <Header lingua={lingua} altraLingua={altraLingua} />
    <main id="contenuto" tabindex="-1">
      <slot />
    </main>
    <Footer lingua={lingua} />
  </body>
</html>
