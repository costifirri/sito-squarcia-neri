---
import Base from '../layouts/Base.astro';
import Dato from '../components/Dato.astro';
import InvitoVisita from '../components/InvitoVisita.astro';
import { studio } from '../lib/studio';
import { ui, rotte, type Lingua } from '../i18n/ui';

interface Props {
  lingua: Lingua;
}

const { lingua } = Astro.props;
const t = ui[lingua];
const testi = {
  it: {
    titolo: 'Chi sono',
    descrizione: `Formazione, specializzazione, iscrizione all'Ordine dei Medici ed esperienza professionale del ${studio.nome}.`,
    presentazione: [
      "Il Dr. Giorgio Squarcia Neri è specialista in Chirurgia Plastica, Ricostruttiva ed Estetica. È autore di diverse pubblicazioni scientifiche e interviene come relatore a congressi nazionali di chirurgia plastica. Ha arricchito la sua formazione con esperienze presso centri europei.",
      "Si dedica alla chirurgia estetica del viso e del corpo, alla chirurgia post-bariatrica e alla medicina estetica. Affianca agli interventi chirurgici trattamenti di medicina estetica mirati, costruendo per ogni paziente un percorso su misura.",
      "Il suo approccio privilegia risultati naturali. Il risultato non deve mai rivelare l’intervento, perché la discrezione è l’essenza di questo lavoro. Deve invece valorizzare la persona, perché la vera bellezza non ha bisogno di eccessi."
    ],
    sezioni: [
      {
        titolo: 'Formazione ed esperienze',
        elenco: [
          'The Institute Marco Gasparotti',
          'Divisione di Chirurgia generale, Centro di eccellenza SICOB per la chirurgia bariatrica, ICOT, Latina',
          'Divisione di Chirurgia plastica, Policlinico Universitario Federico II, Napoli',
          'Divisione di Chirurgia plastica pediatrica, Santobono-Pausilipon',
          'Divisione di Chirurgia oncoplastica, Istituto Nazionale Tumori IRCCS Fondazione G. Pascale',
          'Divisione di Chirurgia plastica, Ospedale Universitario La Paz, Madrid, Spagna',
          'Divisione di Chirurgia plastica, Ospedale Clinico San Carlos, Madrid, Spagna',
          'Aesthetic Fellowship Program, Madrid, Spagna',
          'Divisione di Chirurgia plastica, Ospedale Cardarelli, Napoli',
          'Istituto Estetico Italiano (IEI)',
        ],
      },
      {
        titolo: 'Società scientifiche',
        testo: 'Membro della Società Italiana di Chirurgia Plastica, Ricostruttiva ed Estetica (SICPRE).',
      },
      { titolo: "Iscrizione all'Ordine", testo: `${t.ordine(studio.ordine.provincia, studio.ordine.numero)}.` },
    ],
  },
  en: {
    titolo: 'About',
    descrizione: `Education, specialist training, Medical Council registration and professional experience of ${studio.nome}.`,
    presentazione: [
      "Dr. Giorgio Squarcia Neri is a specialist in Plastic, Reconstructive and Aesthetic Surgery. He is the author of several scientific publications and speaks at national plastic surgery congresses. He has enriched his training with experience at European centres.",
      "He focuses on aesthetic surgery of the face and body, post-bariatric surgery and aesthetic medicine. Alongside surgical procedures he offers targeted aesthetic medicine treatments, building a tailored pathway for each patient.",
      "His approach favours natural results. The result should never reveal the procedure, because discretion is the essence of this work. Instead it should enhance the person, because true beauty has no need of excess."
    ],
    sezioni: [
      {
        titolo: 'Training and experience',
        elenco: [
          'The Institute Marco Gasparotti',
          'General Surgery Division, SICOB Centre of Excellence for bariatric surgery, ICOT, Latina, Italy',
          'Plastic Surgery Division, Federico II University Hospital, Naples, Italy',
          'Paediatric Plastic Surgery Division, Santobono-Pausilipon',
          'Oncoplastic Surgery Division, Istituto Nazionale Tumori IRCCS Fondazione G. Pascale',
          'Plastic Surgery Division, La Paz University Hospital, Madrid, Spain',
          'Plastic Surgery Division, Hospital Clínico San Carlos, Madrid, Spain',
          'Aesthetic Fellowship Program, Madrid, Spain',
          'Plastic Surgery Division, Cardarelli Hospital, Naples, Italy',
          'Istituto Estetico Italiano (IEI)',
        ],
      },
      {
        titolo: 'Scientific societies',
        testo: 'Member of the Italian Society of Plastic, Reconstructive and Aesthetic Surgery (SICPRE).',
      },
      { titolo: 'Medical Council registration', testo: `${t.ordine(studio.ordine.provincia, studio.ordine.numero)}.` },
    ],
  },
}[lingua];
---

<Base
  lingua={lingua}
  titolo={testi.titolo}
  descrizione={testi.descrizione}
  altraLingua={rotte.chiSono[lingua === 'it' ? 'en' : 'it']}
>
  <section class="sezione">
    <div class="contenitore">
      <p class="occhiello">{testi.titolo}</p>
      <h1>{studio.nome}</h1>
      <hr class="linea" />
      <p class="sommario">{studio.qualifica[lingua]}</p>
      <div class="prosa">
        {testi.presentazione.map((paragrafo) => <p>{paragrafo}</p>)}
        {
          testi.sezioni.map((sezione) => (
            <>
              <h2>{sezione.titolo}</h2>
              {'elenco' in sezione && (
                <ul>
                  {sezione.elenco.map((voce) => (
                    <li>{voce}</li>
                  ))}
                </ul>
              )}
              {'testo' in sezione && (
                <p>
                  <Dato valore={sezione.testo} />
                </p>
              )}
            </>
          ))
        }
      </div>
    </div>
  </section>
  <InvitoVisita lingua={lingua} />
</Base>
