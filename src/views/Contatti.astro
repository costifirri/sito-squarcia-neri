---
// L'indirizzo dello studio non viene pubblicato, per scelta del medico: niente indirizzo né mappa.
import Base from '../layouts/Base.astro';
import Dato from '../components/Dato.astro';
import { studio, mancante, linkTelefono, linkEmail, linkWhatsapp } from '../lib/studio';
import { ui, rotte, type Lingua } from '../i18n/ui';

interface Props {
  lingua: Lingua;
}

const { lingua } = Astro.props;
const t = ui[lingua];
const area = studio.area[lingua];
const testi = {
  it: {
    titolo: 'Contatti',
    descrizione: `Telefono, email e WhatsApp del ${studio.nome}. Le visite si svolgono su appuntamento.`,
    sommario: 'Le visite si svolgono su appuntamento.',
    recapiti: 'Recapiti',
    prenotare: 'Come prenotare',
    prenotareTesto:
      'Per fissare una visita è possibile telefonare, scrivere una email o inviare un messaggio WhatsApp. Sede e orario dell’appuntamento vengono comunicati al momento della prenotazione.',
    area: 'Dove riceve',
    riservatezza:
      'Per la tua riservatezza, non inviare referti, fotografie o informazioni dettagliate sulla tua salute via email o WhatsApp: se ne parla direttamente durante la visita.',
  },
  en: {
    titolo: 'Contact',
    descrizione: `Phone, email and WhatsApp of ${studio.nome}. Consultations are by appointment.`,
    sommario: 'Consultations are by appointment.',
    recapiti: 'Contact details',
    prenotare: 'How to book',
    prenotareTesto:
      'To arrange a consultation you can call, send an email or a WhatsApp message. The location and time of the appointment are confirmed when you book.',
    area: 'Where consultations take place',
    riservatezza:
      'For your privacy, please do not send medical reports, photographs or detailed information about your health by email or WhatsApp: these are discussed in person during the consultation.',
  },
}[lingua];
---

<Base
  lingua={lingua}
  titolo={testi.titolo}
  descrizione={testi.descrizione}
  altraLingua={rotte.contatti[lingua === 'it' ? 'en' : 'it']}
>
  <section class="sezione">
    <div class="contenitore">
      <h1>{testi.titolo}</h1>
      <hr class="linea" />
      <p class="sommario">{testi.sommario}</p>

      <div class="due-colonne" style="margin-top: 3rem">
        <div>
          <h2>{testi.recapiti}</h2>
          <dl class="dati">
            <div>
              <dt>{t.telefono}</dt>
              <dd>
                {linkTelefono ? <a href={linkTelefono}>{studio.telefono}</a> : <Dato valore={studio.telefono} />}
              </dd>
            </div>
            <div>
              <dt>{t.email}</dt>
              <dd class="spezza">
                {linkEmail ? <a href={linkEmail}>{studio.email}</a> : <Dato valore={studio.email} />}
              </dd>
            </div>
            {
              !mancante(area) && (
                <div>
                  <dt>{testi.area}</dt>
                  <dd>{area}</dd>
                </div>
              )
            }
          </dl>
        </div>
        <div>
          <h2>{testi.prenotare}</h2>
          <p>{testi.prenotareTesto}</p>
          <div class="azioni">
            {
              linkTelefono && (
                <a class="pulsante" href={linkTelefono}>
                  {t.chiama}
                </a>
              )
            }
            {
              linkWhatsapp && (
                <a class="pulsante pulsante--contorno" href={linkWhatsapp} target="_blank" rel="noopener noreferrer">
                  {t.scriviWhatsapp}
                </a>
              )
            }
          </div>
          <p class="secondario nota">{testi.riservatezza}</p>
        </div>
      </div>
    </div>
  </section>
</Base>
