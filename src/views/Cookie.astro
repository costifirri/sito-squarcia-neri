---
import Base from '../layouts/Base.astro';
import { studio } from '../lib/studio';
import { rotte, type Lingua } from '../i18n/ui';

interface Props {
  lingua: Lingua;
}

const { lingua } = Astro.props;
const testi = {
  it: {
    titolo: 'Cookie policy',
    descrizione: `Informazioni sull'uso dei cookie nel sito del ${studio.nome}: il sito non utilizza cookie di tracciamento.`,
    sezioni: [
      {
        titolo: 'Questo sito non usa cookie di tracciamento',
        paragrafi: [
          'Il sito non installa cookie di profilazione, non usa strumenti di statistica e non incorpora contenuti di terze parti. Per questo motivo non viene mostrato alcun banner di consenso.',
          'I caratteri tipografici e le immagini sono ospitati sullo stesso server del sito e non vengono richiesti a servizi esterni.',
        ],
      },
      {
        titolo: 'Collegamenti a servizi esterni',
        paragrafi: [
          'Il collegamento a WhatsApp apre un servizio di terzi, soggetto alla propria informativa. Nessun dato viene trasmesso finché il visitatore non lo apre.',
        ],
      },
      {
        titolo: 'Come gestire i cookie dal browser',
        paragrafi: [
          'È sempre possibile cancellare o bloccare i cookie dalle impostazioni del proprio browser.',
        ],
      },
    ],
    privacy: 'Per maggiori informazioni sul trattamento dei dati personali si veda la',
    privacyLink: 'privacy policy',
  },
  en: {
    titolo: 'Cookie policy',
    descrizione: `Information on the use of cookies on the website of ${studio.nome}: the website does not use tracking cookies.`,
    sezioni: [
      {
        titolo: 'This website does not use tracking cookies',
        paragrafi: [
          'The website sets no profiling cookies, uses no analytics tools and embeds no third-party content. For this reason no consent banner is shown.',
          'Fonts and images are hosted on the same server as the website and are not requested from external services.',
        ],
      },
      {
        titolo: 'Links to external services',
        paragrafi: [
          'The WhatsApp link opens a third-party service, which is subject to its own policy. No data is transmitted until the visitor opens it.',
        ],
      },
      {
        titolo: 'Managing cookies in your browser',
        paragrafi: ['You can always delete or block cookies in your browser settings.'],
      },
    ],
    privacy: 'For more information on the processing of personal data, see the',
    privacyLink: 'privacy policy',
  },
}[lingua];
---

<Base
  lingua={lingua}
  titolo={testi.titolo}
  descrizione={testi.descrizione}
  altraLingua={rotte.cookie[lingua === 'it' ? 'en' : 'it']}
>
  <section class="sezione">
    <div class="contenitore">
      <h1>{testi.titolo}</h1>
      <hr class="linea" />
      <div class="prosa">
        {
          testi.sezioni.map((sezione) => (
            <>
              <h2>{sezione.titolo}</h2>
              {sezione.paragrafi.map((paragrafo) => (
                <p>{paragrafo}</p>
              ))}
            </>
          ))
        }
        <p>
          {testi.privacy} <a href={rotte.privacy[lingua]}>{testi.privacyLink}</a>.
        </p>
      </div>
    </div>
  </section>
</Base>
