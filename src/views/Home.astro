---
import monogramma from '../../brand/gsn-monogramma-trasparente.svg?url';
import Base from '../layouts/Base.astro';
import Dato from '../components/Dato.astro';
import InvitoVisita from '../components/InvitoVisita.astro';
import { studio } from '../lib/studio';
import { ui, rotte, categorie, nomiCategorie, type Lingua } from '../i18n/ui';

interface Props {
  lingua: Lingua;
}

const { lingua } = Astro.props;
const t = ui[lingua];
const testi = {
  it: {
    titoloPagina: `${studio.nome} | Chirurgo plastico`,
    descrizione: `${studio.nome}, ${studio.qualifica.it.toLowerCase()}. Informazioni su attività, trattamenti e contatti.`,
    occhiello: 'Chirurgia plastica, ricostruttiva ed estetica',
    presentazione: `${studio.qualifica.it}. Riceve su appuntamento.`,
    vediTrattamenti: 'Vedi i trattamenti',
    areeTitolo: 'Aree di attività',
    aree: {
      'chirurgia-estetica': 'Interventi chirurgici che riguardano la forma e le proporzioni del viso e del corpo.',
      'chirurgia-ricostruttiva':
        'Interventi per il ripristino di forma e funzione dopo traumi, malattie, chirurgia oncologica o in presenza di malformazioni.',
      'medicina-estetica': 'Trattamenti ambulatoriali non chirurgici.',
    },
    chiSonoTitolo: 'Chi sono',
    chiSonoTesto: "Il Dr. Giorgio Squarcia Neri è specialista in Chirurgia Plastica, Ricostruttiva ed Estetica. È autore di diverse pubblicazioni scientifiche e interviene come relatore a congressi nazionali di chirurgia plastica. Ha arricchito la sua formazione con esperienze presso centri europei.",
    introTitolo: 'Un percorso su misura',
    intro: [
      "Il volto e il corpo sono la prima forma del nostro racconto: parlano di noi prima di ogni parola, custodiscono la nostra storia e ne conservano le tracce. Accade, talvolta, che l’immagine riflessa nello specchio smetta di somigliarci: perché il tempo ne ha addolcito i contorni, perché la vita ne ha cambiato le forme, o perché la natura non ci ha concesso ciò che sentivamo nostro.",
      "È in questo spazio sottile, tra ciò che si è e ciò che si mostra, che la chirurgia plastica e la medicina estetica trovano il loro senso più autentico. Non inventano un corpo nuovo né impongono un modello da imitare: cercano l’armonia che già appartiene a ogni persona, la portano alla luce e la restituiscono con discrezione. Perché la bellezza non è un canone da riprodurre, ma un equilibrio unico e irripetibile, diverso per ciascuno.",
      "Ogni percorso comincia da un ascolto. Dalle parole, dai desideri e dalle esitazioni di chi si affida prende forma un progetto pensato come un abito cucito su misura: per l’anima, prima ancora che per il corpo. Il risultato non deve mai rivelare l’intervento, ma soltanto la persona: naturale, elegante, armoniosa. Semplicemente sé stessa, finalmente riconosciuta."
    ],
    chiSonoLink: 'Formazione ed esperienza',
  },
  en: {
    titoloPagina: `${studio.nome} | Plastic surgeon`,
    descrizione: `${studio.nome}, ${studio.qualifica.en.toLowerCase()}. Information on areas of practice, treatments and contact details.`,
    occhiello: 'Plastic, reconstructive and aesthetic surgery',
    presentazione: `${studio.qualifica.en}. Consultations by appointment.`,
    vediTrattamenti: 'View treatments',
    areeTitolo: 'Areas of practice',
    aree: {
      'chirurgia-estetica': 'Surgical procedures concerning the shape and proportions of the face and body.',
      'chirurgia-ricostruttiva':
        'Procedures to restore form and function after trauma, illness, cancer surgery or in the presence of malformations.',
      'medicina-estetica': 'Non-surgical outpatient treatments.',
    },
    chiSonoTitolo: 'About',
    chiSonoTesto: "Dr. Giorgio Squarcia Neri is a specialist in Plastic, Reconstructive and Aesthetic Surgery. He is the author of several scientific publications and speaks at national plastic surgery congresses. He has enriched his training with experience at European centres.",
    introTitolo: 'A tailored pathway',
    intro: [
      "The face and the body are the first form of our story: they speak of us before any word, they hold our history and keep its traces. Sometimes the image reflected in the mirror stops resembling us: because time has softened its contours, because life has changed its shapes, or because nature did not grant us what we felt was ours.",
      "It is in this subtle space, between what one is and what one shows, that plastic surgery and aesthetic medicine find their most authentic meaning. They do not invent a new body or impose a model to imitate: they look for the harmony that already belongs to each person, bring it to light and return it with discretion. Because beauty is not a canon to be reproduced, but a unique and unrepeatable balance, different for everyone.",
      "Every journey begins with listening. From the words, wishes and hesitations of those who entrust themselves, a plan takes shape, conceived like a made-to-measure garment: for the soul, even before the body. The result should never reveal the procedure, only the person: natural, elegant, harmonious. Simply themselves, finally recognised."
    ],
    chiSonoLink: 'Training and experience',
  },
}[lingua];
---

<Base
  lingua={lingua}
  titolo={testi.titoloPagina}
  descrizione={testi.descrizione}
  altraLingua={rotte.home[lingua === 'it' ? 'en' : 'it']}
>
  <section class="apertura apertura--scura scuro">
    <div class="contenitore apertura__griglia">
      <div class="apertura__testo">
        <p class="occhiello">{testi.occhiello}</p>
        <h1>{studio.nome}</h1>
        <hr class="linea" />
        <p class="sommario"><Dato valore={testi.presentazione} /></p>
        <div class="azioni">
          <a class="pulsante" href={rotte.contatti[lingua]}>{t.prenota}</a>
          <a class="pulsante pulsante--contorno" href={rotte.trattamenti[lingua]}>{testi.vediTrattamenti}</a>
        </div>
      </div>
      <img class="apertura__monogramma" src={monogramma} alt="" width="1080" height="1080" aria-hidden="true" />
    </div>
  </section>

  <section class="sezione" aria-labelledby="intro-titolo">
    <div class="contenitore">
      <h2 id="intro-titolo" class="nascosto-visivamente">{testi.introTitolo}</h2>
      <div class="introduzione">
        <p class="introduzione__apertura">{testi.intro[0]}</p>
        <div class="introduzione__seguito">
          {testi.intro.slice(1).map((paragrafo) => <p>{paragrafo}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section class="sezione sezione--tenue" aria-labelledby="aree-titolo">
    <div class="contenitore">
      <h2 id="aree-titolo">{testi.areeTitolo}</h2>
      <hr class="linea" />
      <ul class="griglia griglia--3 griglia--numerata">
        {
          categorie.map((categoria) => (
            <li>
              <div class="scheda">
                <h3>
                  <a href={`${rotte.trattamenti[lingua]}#${categoria}`}>{nomiCategorie[categoria][lingua]}</a>
                </h3>
                <p>{testi.aree[categoria]}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sezione" aria-labelledby="chi-sono-titolo">
    <div class="contenitore due-colonne due-colonne--titolo">
      <div>
        <h2 id="chi-sono-titolo">{testi.chiSonoTitolo}</h2>
        <hr class="linea" />
      </div>
      <div>
        <p class="testo-grande">{testi.chiSonoTesto}</p>
        <p><a class="freccia" href={rotte.chiSono[lingua]}>{testi.chiSonoLink}</a></p>
      </div>
    </div>
  </section>

  <InvitoVisita lingua={lingua} />
</Base>
