---
import Trattamento from '../../../views/Trattamento.astro';
import { trattamentiDi } from '../../../lib/trattamenti';

export async function getStaticPaths() {
  const schede = await trattamentiDi('en');
  return schede.map(({ scheda, slug }) => ({ params: { slug }, props: { scheda } }));
}

const { scheda } = Astro.props;
---

<Trattamento lingua="en" scheda={scheda} />
